# workMate 실행 설정
# 이 파일을 .env로 복사한 뒤 필요한 값만 수정하세요. .env는 Git에 포함되지 않습니다.

# Frontend / Electron
VITE_BACKEND_URL=http://127.0.0.1:8765
WORKMATE_BACKEND_URL=http://127.0.0.1:8765
# 개발 중 Renderer DevTools를 자동으로 열 때만 1로 설정합니다.
WORKMATE_OPEN_DEVTOOLS=0
# Electron이 FastAPI를 시작할 Python 실행 파일입니다.
# WORKMATE_PYTHON=/Users/bizntech/Desktop/python/venv/bin/python

# AI Provider: mock은 API 키 없이 동작합니다.
WORKMATE_LLM_PROVIDER=openai
OPENAI_API_KEY=
WORKMATE_LLM_MODEL=gpt-4.1-mini

# 외부 Provider
WORKMATE_MAIL_PROVIDER=mock
WORKMATE_CALENDAR_PROVIDER=google
WORKMATE_TIMEZONE=Asia/Seoul
GOOGLE_CALENDAR_ID=primary
# Google Calendar 사용 시에만 설정합니다. OAuth Client JSON은 저장소 밖에 보관하세요.
# GOOGLE_CALENDAR_CREDENTIALS_PATH=/absolute/path/to/google-oauth-desktop-client.json
# GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json
WORKMATE_MEMORY_PROVIDER=mock
WORKMATE_DATABASE_URL=sqlite:///./data/workmate.db

# --- Bizmeka 메일 (WORKMATE_MAIL_PROVIDER: none | mock | bizmeka). 자세한 내용은 docs/bizmeka-mail-setup.md ---
# BIZMEKA_BASE_URL=
# BIZMEKA_TENANT_ID=
# BIZMEKA_PORTAL_ID=
# BIZMEKA_USER_ID=
# BIZMEKA_MAIL_USER_ID=
# BIZMEKA_MAC_ADDRESS=
# BIZMEKA_FROM_NAME=
# BIZMEKA_REQUEST_ENCODING=form
# 운영 서버 호출은 사내 IT 검증 후에만 1로 변경하세요.
# WORKMATE_MAIL_ALLOW_LIVE=0
